{
  "name": "vibedeck",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "VibeDeck — live workshop presentation platform: AI-authored decks served from an isolated origin, live rooms (polls, Q&A, pulse, recap), and a grounded AI tutor. Runs on Railway.",
  "scripts": {
    "dev": "next dev",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "npm run build:runtime && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.14 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.2",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "next": "15.5.25",
    "node-html-parser": "^7.0.1",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.19",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp"
  }
}
