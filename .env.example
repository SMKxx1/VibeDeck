# VibeDeck environment template. Every variable the app reads, grouped the same
# way as the README's reference table. Everything is OPTIONAL unless marked
# REQUIRED — the app boots with nothing set and degrades feature-by-feature.
# The only browser-exposed values are the two NEXT_PUBLIC_* ones.

# ─── Origins & hosts (the two-origin security model) ─────────────────────────
# The app serves TWO origins from one deployment: the trusted app origin
# (wss-lodge.com — auth cookies, dashboard, APIs) and an isolated deck origin
# (decks.wss-lodge.com) that serves ONLY uploaded-deck content. All three vars
# are unset in local dev; uploaded decks then list but are flagged unavailable
# (fail-closed) rather than crashing.

# BARE hostname of the deck origin — middleware compares it against the Host
# header to decide which origin a request belongs to (default-deny allowlist:
# on this host only /d-content/* and /d-assets/* answer; everything else 404s).
DECK_HOST=decks.wss-lodge.com

# ABSOLUTE origin that serves uploaded decks' own HTML, sandboxed and framed.
# Distinct from DECK_HOST above (bare hostname vs full origin).
DECK_ORIGIN=https://decks.wss-lodge.com

# Origin(s) allowed to FRAME deck content — becomes the frame-ancestors value in
# /d-content's CSP. Space-separate multiple origins (apex + www both serve the
# app): APP_ORIGIN=https://wss-lodge.com https://www.wss-lodge.com
APP_ORIGIN=https://wss-lodge.com

# ─── Auth & accounts (the /login → /dashboard gate) ──────────────────────────
# Login is account-based (a `users` table, scrypt-hashed passwords). These two
# seed the INITIAL ADMIN on first boot. Additional users join by invite (an
# admin mints links at /dashboard/invites) or via Google sign-in + approval.
# Viewers never authenticate. The seed runs once: changing these after the
# admin row exists does NOT change the stored password. Change
# PRESENTER_PASSWORD before first boot.
PRESENTER_USERNAME=presenter
PRESENTER_PASSWORD=change-me

# Secret used to sign session cookies (HMAC). Use a long random string
# (e.g. `openssl rand -hex 32`). REQUIRED IN PRODUCTION: the app FAILS CLOSED
# (every request 503s) if this is unset when NODE_ENV=production — without it
# anyone could forge an admin cookie. A dev-only default applies locally.
AUTH_SECRET=change-me-to-a-long-random-string

# Google sign-in (Authorization-Code OIDC). Optional — /api/auth/google/start
# returns 503 when unset. Register these redirect URIs in Google Cloud Console:
# https://<your-app-host>/api/auth/google/callback (one per host serving the app).
# A NEW Google email becomes a pending account request an admin approves
# (via Telegram below, or at /dashboard/invites).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Telegram approval channel (for Google sign-in requests) ─────────────────
# Optional. When fully configured, a new account request pings the admin's
# Telegram with [Allow]/[Reject] buttons; when not, requests are still persisted
# and approvable at /dashboard/invites. Register the webhook with Telegram's
# setWebhook API, passing TELEGRAM_WEBHOOK_SECRET as secret_token — the webhook
# route rejects calls without that header.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# ─── Postgres (decks, slide metadata, users, guides, assets) ─────────────────
# Optional: if UNSET, the app falls back to the built-in static deck + context —
# everything still works except uploads, accounts beyond the seed, and editing.
# Migrations run in-process on first store access; there is no separate step.
#
# In production use the PRIVATE Railway URL (fast, no egress, plaintext inside
# the project's private network):
#   DATABASE_URL=postgresql://postgres:<password>@postgres.railway.internal:5432/railway
# For LOCAL dev, point DATABASE_URL at the public TCP proxy (needs SSL — handled
# automatically for any non-*.railway.internal host):
#   DATABASE_URL=postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/railway
DATABASE_URL=

# The public TCP-proxy URL, kept for reference / local dev. The app reads
# DATABASE_URL only; copy this into DATABASE_URL locally when you want to hit
# the real DB from your laptop.
DATABASE_PUBLIC_URL=

# PEM CA certificate for the public-proxy TLS path (literal PEM or base64).
# Verification is verify-ca: the chain must anchor to THIS cert, but hostname
# matching is skipped — Railway's TCP proxy forwards to a DB whose leaf cert
# names "localhost", so verify-full can never pass through the proxy. Extract:
#   openssl s_client -starttls postgres -showcerts -connect <host>:<port> \
#     </dev/null | awk '/BEGIN CERT/,/END CERT/'   # last cert = the root CA
DATABASE_CA_CERT=

# pg pool size (default 5).
DATABASE_POOL_MAX=

# ─── Redis & live session (rooms, presence, polls, limits, budget) ───────────
# A standard Redis over TCP (RESP). Use the PUBLIC connection URL — e.g. a
# Railway Redis via its TCP proxy: redis://default:<password>@<host>.proxy.rlwy.net:<port>
# If unset, an in-memory fallback runs (single-instance only). Live-room storage
# keeps ONLY room state and counters — prompts/answers are never persisted.
REDIS_URL=

# How often viewers poll the presenter's position (ms) WHILE a presenter is
# live. Lower = snappier, more Redis commands. Idle/backgrounded tabs back off
# automatically. Browser-exposed (NEXT_PUBLIC_*).
NEXT_PUBLIC_SESSION_POLL_MS=2000
# Fallback "live" deck slug when no deck is published as `main`. Browser-exposed.
NEXT_PUBLIC_LIVE_DECK_SLUG=

# ─── AI / OpenRouter (tutor, explainers, digests, guides, portfolio) ─────────
# Use an OpenRouter key with a HARD SPEND CAP (slide-system-rules.md §9). All AI
# features 503 with ai_not_configured when unset. PRIVACY: the app persists ONLY
# { name, timestamp, token_count } — never prompts or answers.
OPENROUTER_API_KEY=sk-or-...

# Model to route to (any OpenRouter model id). Optional — defaults in code
# (lib/openrouter.ts DEFAULT_MODEL).
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Stronger code-gen model for the Portfolio Builder slide only. Falls back to
# OPENROUTER_MODEL, then the default (see Guideline/portfolio-builder-rules.md).
OPENROUTER_PORTFOLIO_MODEL=

# Give the tutor live web search (OpenRouter "web" plugin). 1/true to enable.
OPENROUTER_WEB_SEARCH=1
# Max web results per answer when web search is on. Optional.
OPENROUTER_WEB_MAX_RESULTS=3

# Shown to OpenRouter for ranking/analytics (optional).
OPENROUTER_SITE_URL=https://wss-lodge.com
OPENROUTER_SITE_NAME=VibeDeck

# Optional shared class password gate for the AI endpoints. If set, viewers
# must enter it once (stored in the browser). Leave blank to disable.
AI_CLASS_PASSWORD=

# Per-name rate limit: max AI questions per ROLLING WINDOW (seconds). Optional.
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Global daily token ceiling across ALL AI features (default 3,000,000). Each
# call reserves AI_TOKEN_RESERVATION tokens up front and reconciles to actual
# usage after — so a burst can't blow past the cap.
AI_DAILY_TOKEN_BUDGET=
AI_TOKEN_RESERVATION=
