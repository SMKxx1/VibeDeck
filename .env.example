# ─── AI sidebar (server-side only — NEVER exposed to the browser) ─────────────
# Use an OpenRouter key with a HARD SPEND CAP (slide-system-rules.md §9).
OPENROUTER_API_KEY=sk-or-...

# Model to route to (any OpenRouter model id). Optional — defaults in code.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Give the chat live web search (OpenRouter "web" plugin). 1/true to enable.
OPENROUTER_WEB_SEARCH=1
# Max web results per answer when web search is on. Optional.
OPENROUTER_WEB_MAX_RESULTS=3

# Shown to OpenRouter for ranking/analytics (optional).
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_SITE_NAME=Class Presentation App

# ─── Redis (live session + pinboard + token tracking) ────────────────────────
# A standard Redis over TCP (RESP). Use the PUBLIC connection URL — e.g. a
# Railway Redis via its TCP proxy: redis://default:<password>@<host>.proxy.rlwy.net:<port>
# If unset, an in-memory fallback runs (single-instance only). Token tracking
# stores ONLY { name, timestamp, token_count } — never prompts or answers.
REDIS_URL=

# Per-name rate limit: max AI questions per ROLLING WINDOW (seconds). Optional.
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Optional shared class password gate for the AI endpoint. If set, the client
# must send it (entered once, stored in the browser). Leave blank to disable.
AI_CLASS_PASSWORD=

# ─── Postgres (editable per-slide speaker notes + AI grounding context) ──────
# Stores the build-host-website deck's speaker notes and chatbot grounding so a
# presenter can edit them at /dashboard/edit/<slug>. Optional: if UNSET, the app
# falls back to the built-in static slide context (lib/decks/*-context.ts) for AI
# grounding and the embed deck's own bridge notes for the presenter console —
# everything still works, editing is just disabled.
#
# In production use the PRIVATE Railway URL (fast, no egress, plaintext inside
# the project's private network):
#   DATABASE_URL=postgresql://postgres:<password>@postgres.railway.internal:5432/railway
# For LOCAL dev, point DATABASE_URL at the public TCP proxy (needs SSL — handled
# automatically for any non-*.railway.internal host):
#   DATABASE_URL=postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/railway
DATABASE_URL=

# The public TCP-proxy URL, kept for reference / local dev. The app reads
# DATABASE_URL only; copy this into DATABASE_URL locally when you want to hit the
# real DB from your laptop.
DATABASE_PUBLIC_URL=

# ─── Presenter login (the /login → /dashboard gate) ──────────────────────────
# The presenter signs in with these; viewers never need them. Change PASSWORD.
PRESENTER_USERNAME=presenter
PRESENTER_PASSWORD=change-me
# Secret used to sign the presenter session cookie. Use a long random string
# (e.g. `openssl rand -hex 32`). If unset, a dev-only default is used.
AUTH_SECRET=change-me-to-a-long-random-string

# ─── Live session (presenter → viewer sync + pinboard) ───────────────────────
# Uses REDIS_URL above. Without it, an in-memory fallback runs (fine for
# local/single-instance; set REDIS_URL for a real multi-device workshop).
# How often viewers poll the presenter's position (ms) WHILE a presenter is
# live. Lower = snappier, more Redis commands. Idle/backgrounded tabs back off
# automatically, so this only applies during an active live session.
NEXT_PUBLIC_SESSION_POLL_MS=2000
# The deck that is "live" (presenter drives, viewers follow). Its slug.
NEXT_PUBLIC_LIVE_DECK_SLUG=build-host-website
